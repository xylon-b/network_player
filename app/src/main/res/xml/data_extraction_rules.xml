<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상. 클라우드 백업과 기기 간 이전 모두에서 비밀번호(서버 목록)와 썸네일 캐시를 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="servers.xml" />
        <exclude domain="file" path="thumbs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="servers.xml" />
        <exclude domain="file" path="thumbs/" />
    </device-transfer>
</data-extraction-rules>
